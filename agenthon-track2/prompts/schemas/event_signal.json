{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticSignal Z_t (LLM output, L13)",
  "type": "object",
  "required": ["assets", "persistence", "regime_evidence", "confidence"],
  "properties": {
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "p_up": {"type": "number", "minimum": 0, "maximum": 1},
          "magnitude": {"enum": ["none", "weak", "moderate", "strong", "extreme"]},
          "vol_view": {"enum": ["lower", "same", "higher", "much_higher"]},
          "tail_side": {"enum": ["none", "up", "down", "both"]}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "direction": {"type": "object", "additionalProperties": {"enum": [-1, 0, 1]}},
          "magnitude": {"enum": ["weak", "moderate", "strong", "extreme"]},
          "vol_view": {"enum": ["lower", "same", "higher", "much_higher"]}
        }
      }
    },
    "persistence": {"enum": ["transient", "medium", "persistent"]},
    "regime_evidence": {"enum": ["supports_calm", "neutral", "supports_stress"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "novelty": {"type": "number", "minimum": 0, "maximum": 1},
    "established": {"type": "boolean"},
    "cited_docs": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "maxLength": 600}
  }
}
